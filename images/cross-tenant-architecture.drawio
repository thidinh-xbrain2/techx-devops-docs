ica;" vertex="1" parent="1"><mxGeometry x="1862" y="158" width="430" height="80" as="geometry"/></mxCell><mxCell id="lg-2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1810" y="252" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg-2-text" value="&lt;b&gt;Cho phép tenant XBrain&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;TechX thêm XBrain vào Cross-tenant access settings, chỉ cho phép group ở bước 1, tin MFA của XBrain.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1862" y="250" width="430" height="80" as="geometry"/></mxCell><mxCell id="lg-3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1810" y="344" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg-3-text" value="&lt;b&gt;Mời guest&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;TechX mời user XBrain; user chấp nhận lời mời và trở thành guest.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1862" y="342" width="430" height="80" as="geometry"/></mxCell><mxCell id="lg-4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1810" y="436" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg-4-text" value="&lt;b&gt;Cấu hình claim&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Name ID của guest lấy từ user.mail thay cho UPN dạng #EXT#.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1862" y="434" width="430" height="80" as="geometry"/></mxCell><mxCell id="lg-5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1810" y="528" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg-5-text" value="&lt;b&gt;Gán và đồng bộ&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Guest vào group TechX, group được gán vào app; SCIM đồng bộ sang IAM Identity Center.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1862" y="526" width="430" height="80" as="geometry"/></mxCell><mxCell id="lg-6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1810" y="620" width="40" height="38" as="geometry"/></mxCell><mxCell id="lg-6-text" value="&lt;b&gt;Cấp quyền AWS&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Gán group với permission set và account; user đăng nhập access portal bằng SAML.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1862" y="618" width="430" height="80" as="geometry"/></mxCell><mxCell id="lg-line" value="&lt;b&gt;Đường liền&lt;/b&gt;: luồng cấu hình và đồng bộ · &lt;b&gt;Đường đứt&lt;/b&gt;: luồng đăng nhập và kiểm soát" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1810" y="680" width="480" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>